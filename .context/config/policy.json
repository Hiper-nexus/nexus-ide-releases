{
  "schemaVersion": 1,
  "mode": "enforce",
  "protectedPaths": [
    ".context"
  ],
  "evidence": {
    "trustedProducer": "nexus",
    "bind": [
      "projectId",
      "checkoutId",
      "missionId",
      "baseSha",
      "headSha",
      "diffHash",
      "contractHash",
      "contextHash",
      "sensorConfigHash"
    ],
    "blockOnSeverities": [
      "critical",
      "high"
    ]
  },
  "review": {
    "requireIndependentAuthor": true,
    "requireDifferentProviderFor": [],
    "minimumReviewers": {
      "high": 1,
      "critical": 2
    }
  }
}
