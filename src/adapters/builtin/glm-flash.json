{
  "kind": "cli-pty",
  "id": "glm-flash",
  "label": "GLM Flash (z.ai)",
  "version": "1.0.0",
  "icon": "◈",
  "bin": "claude",
  "detect": "claude --version",
  "install": {
    "method": "npm",
    "command": "npm install -g @anthropic-ai/claude-code"
  },
  "auth": {
    "method": "api_key",
    "credentialStore": "keychain",
    "envVarFallback": "ANTHROPIC_AUTH_TOKEN",
    "loginHint": "Cole seu token da z.ai/GLM — o MESMO do provider GLM (injetado como ANTHROPIC_AUTH_TOKEN; nunca em plaintext). Equivale ao `ai gf` do launcher: sessão inteira no GLM Flash, mais barata e rápida."
  },
  "spawn": {
    "interactive": [
      "claude",
      "--model",
      "{{MODEL}}"
    ],
    "headless": [
      "claude",
      "--model",
      "{{MODEL}}",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": [
      "--resume"
    ],
    "sessionIdArg": "--session-id",
    "extraArgs": [
      "--permission-mode",
      "acceptEdits"
    ]
  },
  "env": {
    "static": {
      "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
      "API_TIMEOUT_MS": "600000",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
      "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
      "ANTHROPIC_MODEL": "glm-5.3-flash[1m]",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-flash[1m]",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3-flash[1m]",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3-flash[1m]"
    },
    "passthrough": [
      "ANTHROPIC_AUTH_TOKEN",
      "ZAI_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "glm-5.3-flash[1m]",
      "glm-5.3-flash",
      "glm-4.7-flash[1m]",
      "glm-4.7-flash"
    ],
    "default": "glm-5.3-flash[1m]"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": true
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": true,
    "nexusMcp": "autoload"
  },
  "control": {
    "permission": {
      "arg": "--permission-mode",
      "modes": {
        "default": "default",
        "auto": "acceptEdits",
        "plan": "plan",
        "bypass": "bypassPermissions"
      },
      "yolo": [
        "--allow-dangerously-skip-permissions",
        "--dangerously-skip-permissions"
      ],
      "safe": [
        "--permission-mode",
        "manual"
      ],
      "default": ""
    },
    "effort": {
      "arg": "--effort ",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "verbose": "--verbose"
  }
}
