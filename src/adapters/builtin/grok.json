{
  "kind": "cli-pty",
  "id": "grok",
  "label": "Grok",
  "version": "1.0.0",
  "icon": "𝕏",
  "bin": "grok",
  "detect": "grok --version",
  "install": {
    "method": "manual",
    "command": "curl -fsSL https://x.ai/cli/install.sh | bash"
  },
  "auth": {
    "method": "api_key",
    "credentialStore": "keychain",
    "envVarFallback": "XAI_API_KEY",
    "loginHint": "Run `grok login` for grok.com OAuth, or set XAI_API_KEY in provider settings."
  },
  "spawn": {
    "interactive": [
      "grok"
    ],
    "headless": [
      "grok",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--resume"
    ],
    "sessionIdArg": "--session-id",
    "extraArgs": [
      "--trust-folder"
    ]
  },
  "env": {
    "static": {},
    "passthrough": [
      "XAI_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "grok-build",
      "grok-composer-2.5-fast",
      "grok-4.1",
      "grok-4",
      "grok-4-fast",
      "grok-code-fast-1",
      "grok-3"
    ],
    "default": "grok-build"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": true,
    "approvalFlag": "--always-approve",
    "mcpAutoload": false,
    "nexusMcp": "grok"
  },
  "control": {
    "permission": {
      "arg": "",
      "modes": {},
      "yolo": [
        "--always-approve"
      ],
      "safe": [
        "--permission-mode",
        "default",
        "--sandbox",
        "workspace"
      ],
      "default": ""
    }
  }
}
