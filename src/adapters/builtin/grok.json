{
  "kind": "cli-pty",
  "id": "grok",
  "label": "Grok",
  "version": "1.0.0",
  "icon": "𝕏",
  "bin": "grok",
  "detect": "grok --version",
  "install": {
    "method": "manual",
    "command": "curl -fsSL https://x.ai/cli/install.sh | bash"
  },
  "auth": {
    "method": "api_key",
    "credentialStore": "keychain",
    "envVarFallback": "XAI_API_KEY",
    "loginHint": "Rode `grok login` (OAuth) ou cole XAI_API_KEY.",
    "loginCommand": "grok login"
  },
  "spawn": {
    "interactive": [
      "grok"
    ],
    "headless": [
      "grok",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": [
      "--resume"
    ],
    "sessionIdArg": "--session-id",
    "extraArgs": [
      "--trust-folder"
    ]
  },
  "env": {
    "static": {},
    "passthrough": [
      "XAI_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "grok-4.7",
      "grok-4.7-build-fast",
      "grok-4.6",
      "grok-4.5"
    ],
    "default": "grok-4.7"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": true,
    "approvalFlag": "--always-approve",
    "mcpAutoload": false,
    "nexusMcp": "grok"
  },
  "control": {
    "effort": {
      "arg": "--reasoning-effort",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "permission": {
      "arg": "--permission-mode",
      "modes": {
        "default": "default",
        "auto": "acceptEdits",
        "plan": "plan",
        "bypass": "bypassPermissions"
      },
      "yolo": [
        "--always-approve"
      ],
      "safe": [
        "--permission-mode",
        "default",
        "--sandbox",
        "workspace"
      ],
      "readOnly": [
        "--permission-mode",
        "plan",
        "--sandbox",
        "read-only"
      ],
      "default": ""
    }
  },
  "capabilities": {
    "webSearch": true
  }
}
