{
  "kind": "cli-pty",
  "id": "devin",
  "label": "Devin CLI",
  "version": "1.0.0",
  "icon": "❖",
  "bin": "devin",
  "detect": "devin --version",
  "install": {
    "method": "manual",
    "command": "curl -fsSL https://cli.devin.ai/install.sh | bash"
  },
  "auth": {
    "method": "oauth",
    "loginHint": "devin auth login (credenciais em ~/.local/share/devin/credentials.toml)",
    "loginCommand": "devin auth login"
  },
  "spawn": {
    "interactive": [
      "devin"
    ],
    "headless": [
      "devin",
      "--respect-workspace-trust",
      "false",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--resume"
    ],
    "initialPrompt": "paste",
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "swe-2-high",
      "swe-2-max",
      "swe-2-medium",
      "claude-sonnet-5-medium",
      "claude-sonnet-5-high",
      "claude-opus-5-medium",
      "claude-opus-5-high",
      "claude-opus-5-xhigh",
      "claude-opus-5-max",
      "claude-fable-5-1-medium",
      "claude-fable-5-1-high",
      "claude-fable-5-1-max",
      "gemini-3-8-flash-medium",
      "gemini-3-8-flash-high",
      "gpt-6-astra-medium",
      "gpt-6-astra-high",
      "gpt-5-6-sol-medium",
      "gpt-5-6-sol-high",
      "gpt-5-6-luna-high",
      "glm-5-3-high",
      "glm-5-3-max",
      "glm-5-2-max",
      "kimi-k3-high",
      "grok-4-6-high",
      "deepseek-v4-pro-high",
      "inkling-high",
      "adaptive"
    ],
    "default": "swe-2-high"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "control": {
    "permission": {
      "arg": "--permission-mode",
      "modes": {
        "default": "auto",
        "auto": "accept-edits",
        "smart": "smart",
        "bypass": "dangerous"
      },
      "yolo": [
        "--permission-mode",
        "dangerous"
      ],
      "default": ""
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "approvalFlag": "--permission-mode",
    "mcpAutoload": false,
    "nexusMcp": "none"
  }
}
