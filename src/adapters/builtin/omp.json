{
  "kind": "cli-pty",
  "id": "omp",
  "label": "Oh My Pi",
  "version": "1.0.0",
  "icon": "π",
  "bin": "omp",
  "detect": "omp --version",
  "install": {
    "method": "brew",
    "command": "brew install can1357/tap/omp"
  },
  "auth": {
    "method": "oauth",
    "credentialStore": "keychain",
    "loginHint": "Use Contas in the OMP · RPC panel or run `omp auth-broker login` to connect any supported provider."
  },
  "spawn": {
    "interactive": [
      "omp"
    ],
    "headless": [
      "omp",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--resume"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "anthropic/claude-sonnet-4-6",
      "anthropic/claude-sonnet-5",
      "openai-codex/gpt-5.5",
      "zai/glm-5",
      "xai/grok-4.5",
      "deepseek/deepseek-v4-pro"
    ],
    "default": "anthropic/claude-sonnet-4-6"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "omp"
  },
  "control": {
    "effort": {
      "arg": "--thinking",
      "levels": ["low", "medium", "high", "xhigh"]
    },
    "permission": {
      "arg": "--approval-mode",
      "modes": {
        "default": "write",
        "plan": "always-ask"
      },
      "yolo": [
        "--yolo"
      ],
      "safe": [
        "--approval-mode",
        "always-ask"
      ],
      "default": ""
    }
  }
}
