{
  "kind": "cli-pty",
  "id": "muse",
  "label": "Muse Code",
  "version": "1.0.0",
  "icon": "◆",
  "bin": "muse",
  "detect": "muse --version",
  "install": {
    "method": "manual",
    "command": "Consulte a documentação do Muse Spark para instalar a CLI `muse`"
  },
  "auth": {
    "method": "oauth",
    "loginHint": "muse login (credenciais em ~/.config/muse/auth.json)",
    "loginCommand": "muse login"
  },
  "spawn": {
    "interactive": ["muse"],
    "headless": ["muse", "exec", "{{PROMPT}}"],
    "ptyRequired": true,
    "resumeArgs": ["resume", "--last"],
    "resumeIdArgs": ["resume"],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [],
    "default": ""
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "control": {
    "permission": {
      "arg": "--approval-mode",
      "modes": {
        "auto": "never",
        "default": "on-request",
        "untrusted": "untrusted"
      },
      "yolo": ["--yolo"],
      "safe": ["--approval-mode", "on-request"],
      "default": ""
    },
    "effort": {
      "arg": "--reasoning-effort ",
      "levels": ["low", "medium", "high", "xhigh"]
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "approvalFlag": "--approval-mode",
    "mcpAutoload": true,
    "nexusMcp": "autoload"
  }
}
