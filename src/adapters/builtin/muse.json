{
  "kind": "cli-pty",
  "id": "muse",
  "label": "Muse Code",
  "version": "1.0.0",
  "icon": "◆",
  "bin": "muse",
  "detect": "muse --version",
  "install": {
    "method": "brew",
    "command": "brew install --cask muse-code"
  },
  "auth": {
    "method": "oauth",
    "loginHint": "Rode `muse login` (conta Meta) ou cole META_API_KEY. Esta é a CLI própria. Para usar Muse Spark dentro do Claude Code, abra o provider “Muse Spark (via Claude)”.",
    "loginCommand": "muse login"
  },
  "spawn": {
    "interactive": ["muse"],
    "headless": ["muse", "exec", "{{PROMPT}}"],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": ["resume"],
    "extraArgs": ["--trust-workspace"]
  },
  "env": {
    "static": {},
    "passthrough": [],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": ["muse-wonder-full-1.0", "muse-wonder-1.0", "muse-spark-1.3", "muse-spark-1.2"],
    "default": "muse-wonder-1.0"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "control": {
    "permission": {
      "arg": "--approval-mode",
      "modes": {
        "auto": "never",
        "default": "on-request",
        "untrusted": "untrusted"
      },
      "yolo": ["--yolo"],
      "safe": ["--approval-mode", "on-request"],
      "default": ""
    },
    "effort": {
      "arg": "--reasoning-effort ",
      "levels": ["minimal", "low", "medium", "high", "xhigh"]
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "approvalFlag": "--approval-mode",
    "mcpAutoload": false,
    "nexusMcp": "muse"
  }
}
