{
  "kind": "cli-pty",
  "id": "opencode",
  "label": "OpenCode",
  "version": "1.0.0",
  "icon": "◌",
  "bin": "opencode",
  "detect": "opencode --version",
  "install": {
    "method": "brew",
    "command": "brew install anomalyco/tap/opencode"
  },
  "auth": {
    "method": "api_key",
    "envVarFallback": "ANTHROPIC_API_KEY",
    "credentialStore": "env",
    "loginHint": "Set ANTHROPIC_API_KEY or OPENAI_API_KEY in your environment.",
    "loginCommand": "opencode auth login"
  },
  "spawn": {
    "interactive": [
      "opencode"
    ],
    "headless": [
      "opencode",
      "run",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--session"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "opencode/big-pickle",
      "opencode/deepseek-v4-flash-free",
      "opencode/mimo-v2.5-free",
      "opencode/nemotron-3-ultra-free",
      "openrouter/anthropic/claude-sonnet-5",
      "openrouter/anthropic/claude-opus-4.8",
      "openrouter/openai/gpt-5",
      "openrouter/google/gemini-3.1-pro-preview",
      "openrouter/moonshotai/kimi-k2.6",
      "openrouter/openai/gpt-4o"
    ],
    "default": "opencode/big-pickle"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "opencode"
  },
  "control": {
    "permission": {
      "arg": "",
      "modes": {},
      "yolo": [
        "--auto"
      ],
      "default": ""
    }
  }
}
