{
  "kind": "cli-pty",
  "id": "deepseek",
  "label": "DeepSeek",
  "version": "1.0.0",
  "icon": "🌐",
  "bin": "claude",
  "detect": "claude --version",
  "install": {
    "method": "npm",
    "command": "npm install -g @anthropic-ai/claude-code"
  },
  "auth": {
    "method": "api_key",
    "credentialStore": "keychain",
    "envVarFallback": "ANTHROPIC_AUTH_TOKEN",
    "loginHint": "Cole sua API key do DeepSeek (platform.deepseek.com). É injetada como ANTHROPIC_AUTH_TOKEN; nunca em plaintext. DeepSeek roda na CLI do Claude apontada para o endpoint Anthropic-compatible deles."
  },
  "spawn": {
    "interactive": [
      "claude",
      "--model",
      "{{MODEL}}"
    ],
    "headless": [
      "claude",
      "--model",
      "{{MODEL}}",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": [
      "--resume"
    ],
    "sessionIdArg": "--session-id",
    "extraArgs": [
      "--permission-mode",
      "acceptEdits"
    ]
  },
  "env": {
    "static": {
      "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
      "API_TIMEOUT_MS": "600000",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
      "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
      "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-flash",
      "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-pro",
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro"
    },
    "passthrough": [
      "ANTHROPIC_AUTH_TOKEN",
      "DEEPSEEK_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "deepseek-v4-pro",
      "deepseek-flash"
    ],
    "default": "deepseek-v4-pro",
    "families": {
      "deepseek-v4-pro": "deepseek",
      "deepseek-flash": "deepseek"
    }
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": true
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": true,
    "nexusMcp": "autoload"
  },
  "control": {
    "permission": {
      "arg": "--permission-mode",
      "modes": {
        "default": "default",
        "auto": "acceptEdits",
        "plan": "plan",
        "bypass": "bypassPermissions"
      },
      "yolo": [
        "--allow-dangerously-skip-permissions",
        "--dangerously-skip-permissions"
      ],
      "safe": [
        "--permission-mode",
        "manual"
      ],
      "default": ""
    },
    "effort": {
      "arg": "--effort ",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "verbose": "--verbose"
  }
}
