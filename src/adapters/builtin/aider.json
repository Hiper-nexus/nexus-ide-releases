{
  "kind": "cli-pty",
  "id": "aider",
  "label": "Aider",
  "version": "1.0.0",
  "icon": "⚙",
  "bin": "aider",
  "detect": "aider --version",
  "install": {
    "method": "uv",
    "command": "uv tool install --force --python python3.12 --with pip aider-chat@latest"
  },
  "auth": {
    "method": "api_key",
    "envVarFallback": "ANTHROPIC_API_KEY",
    "credentialStore": "env",
    "loginHint": "Cole ANTHROPIC_API_KEY ou OPENAI_API_KEY. Aider não tem login próprio."
  },
  "spawn": {
    "interactive": ["aider"],
    "headless": ["aider", "--message", "{{PROMPT}}", "--yes-always", "--no-auto-commits"],
    "ptyRequired": false,
    "resumeArgs": [],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL",
      "ANTHROPIC_BASE_URL"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "claude-sonnet-5",
      "claude-opus-4-8",
      "claude-haiku-4-5",
      "gpt-5.6-luna",
      "o3",
      "deepseek/deepseek-chat",
      "deepseek/deepseek-coder",
      "claude-sonnet-4-5",
      "gpt-4o"
    ],
    "default": "claude-sonnet-5"
  },
  "promptInjection": {
    "method": "flag",
    "flag": "--message",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": { "type": "regex", "pattern": "^aider>" },
    "shellIntegration": false,
    "exitCodes": { "0": "ok", "1": "error" }
  },
  "quirks": {
    "altScreen": false,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "none"
  },
  "control": {
    "permission": {
      "arg": "",
      "modes": {
        "default": ""
      },
      "yolo": [
        "--yes-always"
      ],
      "default": ""
    },
    "verbose": "--verbose"
  }
}
