{
  "kind": "cli-pty",
  "id": "agy",
  "label": "Antigravity (agy)",
  "version": "1.0.0",
  "icon": "◉",
  "bin": "agy",
  "detect": "agy --version",
  "install": {
    "method": "manual",
    "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
  },
  "auth": {
    "method": "oauth",
    "credentialStore": "keychain",
    "loginHint": "Run `agy` and complete Google OAuth in the browser."
  },
  "spawn": {
    "interactive": [
      "agy"
    ],
    "headless": [
      "agy",
      "--print",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--conversation"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "ANTHROPIC_API_KEY",
      "AGY_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "gemini-3.6-flash-high",
      "gemini-3.6-flash-low",
      "gemini-3.5-flash-high",
      "gemini-3.5-flash-low",
      "gemini-3.1-pro-high",
      "gemini-3.1-pro-low",
      "claude-opus-4-6-thinking",
      "claude-sonnet-4-6-thinking",
      "gpt-oss-120b-medium"
    ],
    "default": "gemini-3.6-flash-high"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 1000
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "agy"
  },
  "control": {
    "permission": {
      "arg": "",
      "modes": {},
      "yolo": [
        "--dangerously-skip-permissions"
      ],
      "safe": [
        "--sandbox"
      ],
      "default": ""
    }
  }
}
