{
  "kind": "cli-pty",
  "id": "agy",
  "label": "Antigravity (agy)",
  "version": "1.0.0",
  "icon": "◉",
  "bin": "agy",
  "detect": "agy --version",
  "install": {
    "method": "manual",
    "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash"
  },
  "auth": {
    "method": "oauth",
    "credentialStore": "keychain",
    "loginHint": "Abra `agy` e conclua o login do Google no navegador. AGY não tem subcomando de login.",
    "loginCommand": "agy"
  },
  "spawn": {
    "interactive": [
      "agy"
    ],
    "headless": [
      "agy",
      "--print",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": [
      "--conversation"
    ],
    "extraArgs": [],
    "initialPrompt": "oneshot",
    "initialPromptArgs": [
      "--print"
    ]
  },
  "env": {
    "static": {},
    "passthrough": [
      "ANTHROPIC_API_KEY",
      "AGY_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "gemini-4-argon",
      "gemini-3.8-flash-high",
      "gemini-3.8-flash-medium",
      "gemini-3.8-flash-low",
      "gemini-3.7-flash-high",
      "gemini-3.7-flash-medium",
      "gemini-3.7-flash-low",
      "gemini-3.6-flash-high",
      "gemini-3.6-flash-medium",
      "gemini-3.6-flash-low",
      "claude-opus-4-6-thinking",
      "claude-sonnet-4-6",
      "gpt-oss-120b-medium"
    ],
    "default": "gemini-3.8-flash-high"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 1000
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "agy"
  },
  "control": {
    "effort": {
      "arg": "--effort",
      "levels": [
        "low",
        "medium",
        "high"
      ]
    },
    "permission": {
      "arg": "",
      "modes": {},
      "yolo": [
        "--dangerously-skip-permissions"
      ],
      "safe": [
        "--sandbox"
      ],
      "readOnly": [
        "--mode",
        "plan"
      ],
      "default": ""
    }
  }
}
