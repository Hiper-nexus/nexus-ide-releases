{
  "kind": "cli-pty",
  "id": "claude",
  "label": "Claude",
  "version": "1.0.0",
  "icon": "◆",
  "bin": "claude",
  "detect": "claude --version",
  "install": {
    "method": "npm",
    "command": "npm install -g @anthropic-ai/claude-code"
  },
  "auth": {
    "method": "oauth",
    "credentialStore": "keychain",
    "loginHint": "Run `claude` in a terminal to authenticate via browser OAuth. Your session will be stored securely in the macOS Keychain."
  },
  "spawn": {
    "interactive": [
      "claude",
      "--model",
      "{{MODEL}}"
    ],
    "headless": [
      "claude",
      "--model",
      "{{MODEL}}",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_BASE_URL",
      "CLAUDE_API_KEY"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "claude-opus-4-8",
      "claude-fable-5",
      "claude-sonnet-5",
      "claude-opus-4-7",
      "claude-haiku-4-5",
      "claude-sonnet-4-6",
      "claude-opus-4-6",
      "claude-sonnet-4-5",
      "claude-opus-4-5"
    ],
    "default": "claude-sonnet-5"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error",
      "2": "usage"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": true
  },
  "control": {
    "permission": {
      "arg": "--permission-mode",
      "modes": {
        "default": "default",
        "auto": "acceptEdits",
        "plan": "plan",
        "bypass": "bypassPermissions"
      },
      "yolo": [
        "--dangerously-skip-permissions"
      ],
      "default": ""
    },
    "verbose": "--verbose"
  }
}
