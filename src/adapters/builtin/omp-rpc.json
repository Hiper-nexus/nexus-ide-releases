{
  "kind": "cli-rpc",
  "id": "omp-rpc",
  "label": "Oh My Pi · RPC",
  "version": "1.0.0",
  "icon": "π",
  "bin": "omp",
  "detect": "omp --version",
  "install": {
    "method": "brew",
    "command": "brew install can1357/tap/omp"
  },
  "auth": {
    "method": "oauth",
    "credentialStore": "keychain",
    "loginHint": "Run `omp` and use /login for Anthropic/OpenAI/Gemini OAuth, or set provider API keys via omp settings."
  },
  "models": {
    "flag": "--model",
    "list": [
      "anthropic/claude-sonnet-4-6",
      "anthropic/claude-sonnet-5",
      "openai-codex/gpt-5.5",
      "zai/glm-5",
      "xai/grok-4.5",
      "deepseek/deepseek-v4-pro"
    ],
    "default": "anthropic/claude-sonnet-4-6"
  }
}
