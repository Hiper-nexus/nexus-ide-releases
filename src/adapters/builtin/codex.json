{
  "kind": "cli-pty",
  "id": "codex",
  "label": "Codex",
  "version": "1.0.0",
  "icon": "⬡",
  "bin": "codex",
  "detect": "codex --version",
  "install": {
    "method": "npm",
    "command": "npm install -g @openai/codex"
  },
  "auth": {
    "method": "api_key",
    "envVarFallback": "OPENAI_API_KEY",
    "credentialStore": "keychain",
    "loginHint": "Rode `codex login` ou cole OPENAI_API_KEY.",
    "loginCommand": "codex login"
  },
  "spawn": {
    "interactive": [
      "codex"
    ],
    "headless": [
      "codex",
      "--ask-for-approval",
      "on-request",
      "exec",
      "--sandbox",
      "workspace-write",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [],
    "resumeIdArgs": [
      "resume"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "gpt-6-astra",
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna",
      "gpt-5.2",
      "o4-mini",
      "o3",
      "o3-mini",
      "gpt-4.1",
      "gpt-4o"
    ],
    "default": "gpt-5.6-sol"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "approvalFlag": "--ask-for-approval",
    "mcpAutoload": false,
    "nexusMcp": "codex"
  },
  "control": {
    "permission": {
      "arg": "--ask-for-approval",
      "modes": {
        "auto": "never",
        "default": "on-request"
      },
      "yolo": [
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "safe": [
        "--sandbox",
        "workspace-write",
        "--ask-for-approval",
        "on-request"
      ],
      "default": ""
    },
    "effort": {
      "arg": "-c model_reasoning_effort=",
      "levels": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    }
  }
}
