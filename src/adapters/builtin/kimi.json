{
  "kind": "cli-pty",
  "id": "kimi",
  "label": "Kimi",
  "version": "1.0.0",
  "icon": "🌙",
  "bin": "kimi",
  "detect": "kimi --version",
  "install": {
    "method": "npm",
    "command": "npm install -g @moonshot-ai/kimi-code"
  },
  "auth": {
    "method": "api_key",
    "credentialStore": "keychain",
    "envVarFallback": "KIMI_MODEL_API_KEY",
    "loginHint": "Run `kimi login` for Kimi Code OAuth, or save a Moonshot API key in Nexus."
  },
  "spawn": {
    "interactive": [
      "kimi"
    ],
    "headless": [
      "kimi",
      "-p",
      "{{PROMPT}}"
    ],
    "ptyRequired": true,
    "resumeArgs": [
      "--continue"
    ],
    "resumeIdArgs": [
      "--session"
    ],
    "extraArgs": []
  },
  "env": {
    "static": {},
    "passthrough": [
      "KIMI_MODEL_NAME",
      "KIMI_MODEL_API_KEY",
      "KIMI_MODEL_PROVIDER_TYPE",
      "KIMI_MODEL_BASE_URL",
      "KIMI_MODEL_MAX_CONTEXT_SIZE",
      "KIMI_MODEL_CAPABILITIES",
      "KIMI_MODEL_DISPLAY_NAME",
      "KIMI_MODEL_MAX_OUTPUT_SIZE",
      "KIMI_MODEL_REASONING_KEY",
      "KIMI_MODEL_THINKING_EFFORT",
      "KIMI_MODEL_ADAPTIVE_THINKING",
      "KIMI_MODEL_MAX_COMPLETION_TOKENS",
      "KIMI_MODEL_TEMPERATURE",
      "KIMI_MODEL_TOP_P",
      "KIMI_MODEL_THINKING_KEEP"
    ],
    "ephemeralHome": false
  },
  "models": {
    "flag": "--model",
    "list": [
      "kimi-code/kimi-for-coding",
      "kimi-k2.7",
      "kimi-k2.6",
      "kimi-k2-turbo",
      "kimi-k2",
      "moonshot-v1-128k",
      "moonshot-v1-32k"
    ],
    "default": "kimi-code/kimi-for-coding"
  },
  "promptInjection": {
    "method": "arg",
    "trailingNewline": false,
    "bracketedPaste": false
  },
  "stateParsing": {
    "idle": {
      "type": "timeout",
      "ms": 800
    },
    "shellIntegration": false,
    "exitCodes": {
      "0": "ok",
      "1": "error"
    }
  },
  "quirks": {
    "altScreen": true,
    "requiresNoAutoUpdate": false,
    "mcpAutoload": false,
    "nexusMcp": "kimi"
  },
  "control": {
    "permission": {
      "arg": "",
      "modes": {},
      "yolo": [
        "--yolo"
      ],
      "default": ""
    }
  }
}
