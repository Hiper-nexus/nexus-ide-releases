# Dependencies
node_modules/

# Build outputs
dist/
# Audited source payload for the local brace-expansion compatibility package.
# Keep this exception file-exact: any new upstream byte requires provenance.
!third_party/brace-expansion-compat/upstream/dist/
!third_party/brace-expansion-compat/upstream/dist/commonjs/
!third_party/brace-expansion-compat/upstream/dist/commonjs/index.js
!third_party/brace-expansion-compat/upstream/dist/commonjs/index.js.map
!third_party/brace-expansion-compat/upstream/dist/commonjs/index.d.ts
!third_party/brace-expansion-compat/upstream/dist/commonjs/index.d.ts.map
!third_party/brace-expansion-compat/upstream/dist/commonjs/package.json
server/dist-relay/
out/
build/*
# ...but keep the source-controlled macOS packaging/signing configuration.
# Forge imports these files during a clean CI checkout, so none may remain
# ignored just because generated build output also lives under build/.
!build/entitlements.mac.plist
!build/entitlements.mac.helper.plist
!build/entitlements.mac.plugin.plist
!build/entitlements.mac.none.plist
!build/notarize.md
!build/entitlements.mac.renderer.plist
!build/mac-signing.ts
!build/mac-signing.test.ts
!build/macos-info-plist.ts
!build/macos-info-plist.test.ts
!build/prune-native-payload.ts
!build/prune-native-payload.test.ts
!build/release-npm-integrity.json
!build/release-tag-signers.json
.next/
.nuxt/

# Electron
app/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

# Electron Forge / Vite build
.vite/
out/

# Bundles/model candidates generated by local release and wake-word tooling.
# The portable project identity remains versioned at .nexus/project.json.
/main.js
/resources/native/darwin/nexus-pty-supervisor
/.nexus/wake-candidates/
/training/wake-ptbr/artifacts/
/training/ei-jarvis/work/
/training/ei-jarvis/.venv/
/training/ei-jarvis/livekit_run/
/training/ei-jarvis/recordings/
/.venv-wake/

# Estado local de ferramentas de terceiros (pode conter tokens de auth) —
# nunca versionar dados de outros apps que apareçam no working dir.
.external-apps/
.gemini/
.grok/
.kimi/
.codex/
.claude/
.aider*
.overclock-app/
# Wiki gerada pelo Qoder a partir do código: derivável, pesada e sempre defasada.
.qoder/

# Dev Electron shell with its own stable TCC identity (com.nexuside.dev)
.dev-electron/

# Dev-only SQLite/settings/session state; keeps the installed app untouched.
.dev-user-data/

# Generated codebase graph and extraction cache (kept locally for audits).
graphify-out/

# packaged release artifacts (generated)
release-assets/
# Saídas dos gates de release (SBOM, audit, receipt): regeradas a cada build e
# publicadas como assets da release — versioná-las só suja a árvore e faz o
# gate recusar publicar, porque ele exige checkout limpo até de untracked.
release-artifacts/
# Auditorias geradas por versão (output/audit-v0.19.x)
/output/

# Local scrape / package scratch
.firecrawl/
/.cache/
*.tgz
scripts/codesign-retry-bin/

# Artefatos de runtime do próprio Nexus (logs, execuções, auditoria visual):
# são gerados por uso local e não pertencem ao histórico.
/.nexus/logs/
/.nexus/pet-hatch-runs/
/.nexus/ui-audit/
/.nexus/attachments/
# Inventário local de servidores MCP: carrega credenciais de auth.
/.nexus/mcp-hub.json
# Capturas da auditoria visual (Impeccable). As críticas em .impeccable/critique
# continuam versionadas — só os PNGs, que são regeráveis, ficam de fora.
/.impeccable/shots/
# tsbuildinfo com nome fora do padrão *.tsbuildinfo
/.tsb-verify-skeptic
# Helpers de depuração via CDP, criados por sessão e descartáveis
/.cdp-*.mjs
