{
  "name": "@nexus/server",
  "version": "0.76.124",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "relay:build": "node scripts/build-relay.mjs",
    "relay:start": "node --enable-source-maps dist-relay/index.js",
    "relay:smoke": "npm run relay:build && node scripts/smoke-relay.mjs",
    "smoke:artifact": "node scripts/smoke-built-server.mjs",
    "verify:artifact": "npm run build && npm run smoke:artifact",
    "stripe:provision": "tsx scripts/provision-stripe.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "body-parser": "1.20.6",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "stripe": "^22.3.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "supertest": "^7.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
