{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDirs": ["src", "../shared"],
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/provision-stripe.ts", "../shared/**/*"]
}
