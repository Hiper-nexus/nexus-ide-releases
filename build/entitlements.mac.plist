<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened-runtime entitlements for the notarized macOS build.
      Entitlements for the TOP-LEVEL NexusIDE executable only. V8 requires
      JIT; microphone capture is an explicit product feature. Helpers and
      libraries use narrower profiles selected in build/mac-signing.ts.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Push-to-talk voice capture (Jarvis mode). Pairs with the
         NSMicrophoneUsageDescription string set in forge.config.ts. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
