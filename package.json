{
  "name": "nexus-ide",
  "productName": "NexusIDE",
  "version": "0.50.4",
  "description": "Terminal IDE multi-agente: grid de panes de terminal com PTYs reais, base para adapters de CLIs de IA e orquestração de squads.",
  "main": ".vite/build/main.js",
  "author": "NexusIDE",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs && node scripts/patch-node-pty-darwin.mjs",
    "build:darwin-pty-supervisor": "node scripts/build-darwin-pty-supervisor.mjs",
    "prepackage": "node scripts/patch-node-pty-darwin.mjs && node scripts/bundle-skills.mjs && node scripts/check-build-node.mjs && npm run build:darwin-pty-supervisor && npm run security:renderer-sinks && npm run typecheck && npm run rebuild:electron",
    "postpackage": "npm run rebuild:node && npm run smoke:package",
    "prestart": "node scripts/patch-node-pty-darwin.mjs && npm run build:darwin-pty-supervisor",
    "start": "node scripts/dev-start.mjs",
    "prestart:forge": "node scripts/patch-node-pty-darwin.mjs && npm run build:darwin-pty-supervisor",
    "package": "electron-forge package",
    "smoke:package": "node scripts/smoke-packaged-app.mjs",
    "release:security": "node scripts/release-security-gate.mjs",
    "release:candidate": "node scripts/release-candidate-gate.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "security:renderer-sinks": "node scripts/check-renderer-sinks.mjs",
    "premake": "node scripts/patch-node-pty-darwin.mjs && node scripts/bundle-skills.mjs && node scripts/check-build-node.mjs && npm run build:darwin-pty-supervisor && npm run security:renderer-sinks && npm run typecheck && npm run rebuild:electron",
    "postmake": "npm run rebuild:node",
    "make": "electron-forge make",
    "make:release": "node scripts/make-release.mjs",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "electron-rebuild -f -s -w @lydell/node-pty -w better-sqlite3 -w onnxruntime-node && node scripts/patch-node-pty-darwin.mjs",
    "rebuild:node": "node scripts/rebuild-node-natives.mjs && node scripts/check-node-natives.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/check-node-natives.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "eval:export-ranking": "node --import tsx scripts/export-public-ranking.mjs",
    "eval:benchmark:verify": "node --import tsx scripts/verify-nexus-benchmark.mjs",
    "start:forge": "electron-forge start"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@12.0.0",
  "nexusRelease": {
    "node": "22.22.3"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@ennuicastr/webrtcaec3.js": "^0.3.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.1",
    "better-sqlite3": "^12.11.1",
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-node": "^1.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.0",
    "recast": "^0.23.11",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.7.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/osx-sign": "^1.3.3",
    "@electron/rebuild": "^4.1.0",
    "@noble/hashes": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "appdmg": "file:third_party/appdmg-secure",
    "brace-expansion": "file:third_party/brace-expansion-compat",
    "drizzle-orm": "^0.45.2",
    "electron": "^43.0.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.1",
    "appdmg": "$appdmg",
    "brace-expansion": "$brace-expansion",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.4",
    "fast-uri": "3.1.5",
    "ip-address": "10.4.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "undici": "7.29.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "node-gyp": {
      "undici": "6.28.0"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true,
    "onnxruntime-node@1.19.2": true,
    "tesseract.js@7.0.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  },
  "optionalDependencies": {
    "ssh2": "^1.17.0"
  }
}
