{
  "name": "nexus-ide",
  "productName": "NexusIDE",
  "desktopName": "nexus-ide.desktop",
  "version": "0.76.188",
  "description": "Terminal IDE multi-agente: grid de panes de terminal com PTYs reais, base para adapters de CLIs de IA e orquestração de squads.",
  "main": ".vite/build/main.js",
  "author": "NexusIDE",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "postinstall": "node scripts/install-electron.mjs && node scripts/patch-node-pty-darwin.mjs",
    "build:darwin-pty-supervisor": "node scripts/build-darwin-pty-supervisor.mjs",
    "build:windows-icon": "node scripts/build-windows-icon.mjs",
    "build:macos-icon": "node scripts/build-macos-icon.mjs",
    "build:app-icons": "npm run build:windows-icon && npm run build:macos-icon",
    "prepackage": "node scripts/patch-node-pty-darwin.mjs && node scripts/bundle-skills.mjs && node scripts/check-build-node.mjs && npm run build:darwin-pty-supervisor && npm run build:menubar && npm run security:renderer-sinks && npm run typecheck && npm run rebuild:electron",
    "postpackage": "npm run rebuild:node && npm run smoke:package",
    "prestart": "node scripts/patch-node-pty-darwin.mjs && npm run build:darwin-pty-supervisor",
    "start": "node scripts/dev-start.mjs",
    "prestart:forge": "node scripts/patch-node-pty-darwin.mjs && npm run build:darwin-pty-supervisor",
    "package": "electron-forge package",
    "smoke:package": "node scripts/smoke-packaged-app.mjs",
    "release:security": "node scripts/release-security-gate.mjs",
    "release:candidate": "node scripts/release-candidate-gate.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:publish:windows": "node scripts/publish-release.mjs --windows",
    "release:publish:macos": "node scripts/publish-release.mjs --macos",
    "release:publish:linux": "node scripts/publish-linux-release.mjs",
    "release:mac": "node scripts/release-mac-detached.mjs",
    "security:renderer-sinks": "node scripts/check-renderer-sinks.mjs",
    "design:palette-check": "node --import tsx scripts/check-palette-contrast.mjs",
    "premake": "node scripts/patch-node-pty-darwin.mjs && node scripts/bundle-skills.mjs && node scripts/check-build-node.mjs && npm run build:darwin-pty-supervisor && npm run build:menubar && npm run security:renderer-sinks && npm run typecheck && npm run rebuild:electron",
    "postmake": "npm run rebuild:node",
    "make": "electron-forge make",
    "make:release": "node scripts/make-release.mjs",
    "notary": "node scripts/nexus-notary.mjs",
    "rebuild": "npm run rebuild:electron",
    "rebuild:electron": "node scripts/rebuild-electron-natives.mjs && node scripts/patch-node-pty-darwin.mjs",
    "rebuild:node": "node scripts/rebuild-node-natives.mjs && node scripts/check-node-natives.mjs",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "lint:oxlint": "oxlint src server scripts",
    "lint:oxlint:ratchet": "oxlint --max-warnings 168 src server scripts",
    "pretest": "node scripts/check-node-natives.mjs",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "eval:export-ranking": "node --import tsx scripts/export-public-ranking.mjs",
    "eval:benchmark:verify": "node --import tsx scripts/verify-nexus-benchmark.mjs",
    "bench:vector-retrieval": "node scripts/benchmark-vector-retrieval.mjs",
    "start:forge": "electron-forge start",
    "build:menubar": "node scripts/build-macos-menubar.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@12.0.0",
  "nexusRelease": {
    "node": "22.23.2"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@ennuicastr/webrtcaec3.js": "^0.3.0",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-squirrel-startup": "^1.0.1",
    "onnxruntime-node": "^1.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.0",
    "recast": "^0.23.11",
    "selfsigned": "^5.5.0",
    "smol-toml": "^1.8.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/osx-sign": "^1.3.3",
    "@electron/rebuild": "^4.1.0",
    "@noble/hashes": "^1.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "brace-expansion": "file:third_party/brace-expansion-compat",
    "drizzle-orm": "^0.45.2",
    "electron": "^43.7.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.82.0",
    "vite": "^8.1.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.1",
    "appdmg": "$appdmg",
    "brace-expansion": "$brace-expansion",
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.4",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "undici": "7.29.1",
    "qs": "6.16.0",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "node-gyp": {
      "undici": "6.28.1"
    }
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@12.11.1": true,
    "electron-winstaller@5.4.4": true,
    "fs-xattr@0.3.1": true,
    "fsevents@2.3.3": true,
    "macos-alias@0.2.12": true,
    "onnxruntime-node@1.19.2": true,
    "tesseract.js@7.0.0": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  },
  "optionalDependencies": {
    "appdmg": "file:./third_party/appdmg-0.6.6.tgz",
    "ssh2": "^1.17.0"
  }
}
