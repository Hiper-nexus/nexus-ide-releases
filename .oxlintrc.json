{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc", "promise"],
  "jsPlugins": ["./oxlint-plugin-nexus/index.mjs"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "nexus/require-suppression-reason": "error",
    "nexus/no-test-in-loop": "error",
    "no-unsafe-optional-chaining": "warn",
    "no-unsafe-finally": "warn",
    "no-misleading-character-class": "warn",
    "no-unused-expressions": "warn",
    "no-unused-vars": "warn",
    "no-useless-catch": "warn",
    "preserve-caught-error": "warn",
    "max-lines": ["warn", { "max": 1500, "skipBlankLines": true, "skipComments": true }],
    "max-depth": ["warn", 4],

    "no-control-regex": "off",
    "no-array-sort": "off",
    "no-array-reverse": "off",
    "no-underscore-dangle": "off",
    "consistent-function-scoping": "off",
    "always-return": "off",
    "no-callback-in-promise": "off",
    "no-useless-spread": "off",
    "no-useless-fallback-in-spread": "off",
    "prefer-string-starts-ends-with": "off",
    "prefer-add-event-listener": "off",
    "no-new-array": "off",
    "no-useless-escape": "off",
    "no-shadow": "off",
    "no-this-alias": "off",
    "no-named-as-default": "off",
    "complexity": "off",
    "max-nested-callbacks": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.test.tsx", "*.e2e.test.ts", "*.integration.test.ts", "src/test/**"],
      "rules": {
        "max-lines": "off",
        "max-depth": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "out/",
    ".vite/",
    ".dev-user-data/",
    ".dev-user-data.bak-*/",
    ".dev-user-data-qa/",
    ".qwen/",
    "assets/",
    "docs/qa/evidence/",
    "docs/analysis/overclock-13318-extract/",
    "src/vendor/",
    "mobile/"
  ]
}
