+import {describe,it,expect,vi} from 'vitest';
+vi.mock('../jev/jev-secrets',()=>({hasJevCredential:()=>true}));
+vi.mock('../jev/jev-autopilot',()=>({isJevAutopilotEnabled:()=>true,isJevSurfaceEnabled:()=>true}));
+import {combineEnsembleAnswers} from './decision-ensemble';
